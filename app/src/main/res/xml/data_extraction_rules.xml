<?xml version="1.0" encoding="utf-8"?><!--
    FIX(BUG #3): Privacy hardening (API 31+ rules).
    Watch history / interest profiling data stays on-device: excluded from both
    cloud backup (Google Drive) and device transfer (d2d).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="vidly_db" />
        <exclude domain="database" path="vidly_db-wal" />
        <exclude domain="database" path="vidly_db-shm" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="vidly_db" />
        <exclude domain="database" path="vidly_db-wal" />
        <exclude domain="database" path="vidly_db-shm" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
