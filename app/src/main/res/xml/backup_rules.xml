<?xml version="1.0" encoding="utf-8"?><!--
    FIX(BUG #3): Privacy hardening. Vidly is a "no tracking" app: the local
    Room database contains the user's watch history, search history, learned
    interest profile and subscriptions. None of that may ever leave the device
    via cloud backup or device-to-device transfer.

    allowBackup is now "false" in the manifest; these rules are kept as an
    explicit defense-in-depth statement (and are respected if allowBackup is
    ever re-enabled).
-->
<full-backup-content>
    <exclude domain="database" path="vidly_db" />
    <exclude domain="database" path="vidly_db-wal" />
    <exclude domain="database" path="vidly_db-shm" />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
